# __APP_NAME__ 环境变量示例
# 规则（契约 CONTRACTS/env-naming.md）：前缀 __APP_PREFIX__；带单位；敏感值只在运行时注入。
# 使用：复制为 .env 后填本地值。.env 禁止提交（见 .gitignore）。

# --- 通用 ---
__APP_PREFIX__ENV=local                 # local/dev/test/prod
__APP_PREFIX__SERVICE_NAME=__APP_NAME__
__APP_PREFIX__LOG_LEVEL=INFO            # DEBUG/INFO/WARN/ERROR
__APP_PREFIX__TIMEZONE=Asia/Shanghai     # 防止容器默认 UTC 造成时间错位

# --- 出站 HTTP ---
__APP_PREFIX__HTTP_TIMEOUT_MS=10000
__APP_PREFIX__HTTP_MAX_RETRIES=2        # 仅对幂等请求生效

# --- 项目专属（按需增删，每项都要写默认值与影响范围）---
# __APP_PREFIX__DB_DSN=mysql+aiomysql://user:pass@host:3306/db   # 生产必填，缺失即启动失败
__APP_PREFIX__DOWNSTREAM_BASE_URL=http://127.0.0.1:8080
__APP_PREFIX__DEMO_FEATURE_ENABLED=false
