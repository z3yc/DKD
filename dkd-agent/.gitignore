######################################################################
# dkd-agent · 忽略规则（与根级 .gitignore 叠加生效）
######################################################################

# ---- Python 虚拟环境与缓存 ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 会话持久化（SQLite checkpointer 运行期数据，不入仓）----
# 注意：该文件承载多轮会话状态，部署环境必须纳入定期备份（方案 V1.1 §5.1）
var/
*.db
*.db-journal
*.db-wal

# ---- 本地临时 ----
*.local.env
