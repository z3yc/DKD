# ============================================================================
# DKD 平台 · 部署环境变量模板
#
# 用法：cp .env.deploy.example .env.deploy && chmod 600 .env.deploy
#   ⚠️ `.env.deploy` 已在仓库 .gitignore 中排除；**禁止**把真值写回本文件或任何入仓文件
#      （AGENTS §7.1 安全红线：密钥永不入库，AI 助手生成配置时必须用占位符）。
#   ⚠️ 口令请用「URL 安全」字符（字母数字 + -_.~）：智能体侧要用它拼 MySQL DSN，
#      出现 @ : / ? # 会把连接串拼坏（现网踩过同类问题）。
# ============================================================================

# ---------- 基础 ----------
DKD_TZ=Asia/Shanghai
# 镜像 tag：默认 latest；**回滚时就换成上一版 tag**（例：DKD_IMAGE_TAG=2026-09-23-1）
DKD_IMAGE_TAG=latest
# 前端/反代对外端口（80 需要 root 或已授权；占用时改成 8081 之类）
DKD_HTTP_PORT=80
# 仅回环暴露（排查用 SSH 隧道，不对外）：管理后台、MySQL
DKD_ADMIN_PUBLISH_PORT=18080
DKD_DB_PUBLISH_PORT=3306
# 运维移动端对外端口（用 --profile mobile 才生效；建议防火墙只放行运维网段）
DKD_APP_PORT=9070

# ---------- MySQL（业务库；agent_* 五张表也在这里，见排期决策）----------
# 用外部托管数据库时改成外部地址（并去掉 infra compose 文件）
DKD_DB_HOST=mysql
DKD_DB_PORT=3306
DKD_DB_NAME=dkd
DKD_DB_USERNAME=root
DKD_DB_PASSWORD=CHANGE_ME
# Druid 监控台口令（/druid/**，默认账号 ruoyi）。**不要经 nginx 暴露**，只走 SSH 隧道
DKD_DRUID_PASSWORD=CHANGE_ME

# ---------- Redis（只服务 Java：令牌/验证码/限流；智能体不用它 —— 排期 FIX-14）----------
DKD_REDIS_HOST=redis
DKD_REDIS_PORT=6379
DKD_REDIS_PASSWORD=CHANGE_ME

# ---------- Java 侧 ----------
# JWT 密钥：强随机、长度 ≥32；**轮换会让所有在线用户掉线**，需在值班窗口做
DKD_JWT_SECRET=CHANGE_ME_32_BYTES_MIN
DKD_OSS_ACCESS_KEY=CHANGE_ME
DKD_OSS_SECRET_KEY=CHANGE_ME
# DeepSeek：Java（AI 报表）与 Python（Agent）共用同一账号
DKD_DEEPSEEK_API_KEY=sk-CHANGE_ME
# 智能体网关/回调密钥：Java 与 Python **必须逐字一致**（不一致表现为回调 401）
DKD_AGENT_SERVICE_SECRET=CHANGE_ME
# 一键降级开关：false 时前端隐藏智能体入口、/agent/** 返回 503 信封，主业务零影响
DKD_AGENT_ENABLED=true
DKD_AGENT_BASE_URL=http://dkd-agent:8090
DKD_ADMIN_JAVA_OPTS=-Xms512m -Xmx1024m
DKD_APP_JAVA_OPTS=-Xms256m -Xmx512m

# ---------- Python 智能体 ----------
DKD_AGENT_ENV=prod
# 智能体使用的 MySQL **最小权限账号**（两级授权由 scripts/setup-agent-db.sh 落库）
DKD_AGENT_DB_USER=dkd_agent
DKD_AGENT_DB_PASSWORD=CHANGE_ME
DKD_AGENT_DB_HOST=mysql
DKD_AGENT_DB_PORT=3306
DKD_AGENT_DB_NAME=dkd
# 账号 host 白名单：容器部署**必须**放宽（容器里的 127.0.0.1 是 agent 自己，连不到 MySQL）。
# 生产建议收窄到 compose 网段（先 `docker network inspect dkd-net` 看网段，如 172.16.238.%）
DKD_AGENT_DB_HOST_PATTERN=%
# 真实调用 LLM：1=开；密钥未就绪时先设 0（echo 链路）把全栈跑通再改 1
DKD_AGENT_USE_LLM=1
# 决策留痕/成本计量：1=开（AGENTS §6.3 审计要求，生产不得关）
DKD_AGENT_AUDIT_ENABLED=1
# 日 token 限额（0=不限）；超限返回 429，防成本失控
DKD_AGENT_TOKEN_LIMIT_PER_USER=200000
DKD_AGENT_TOKEN_LIMIT_GLOBAL=2000000

# ---------- 构建期加速（国内网络；留空则用官方源）----------
MAVEN_MIRROR=https://maven.aliyun.com/repository/public
NPM_REGISTRY=https://registry.npmmirror.com
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
