######################################################################
# DKD 环境变量模板
#
# 用途：application.yml 中的所有凭据均已改为 ${DKD_*} 占位符，本文件列出全部变量。
# 用法：
#   1) 复制本文件为 .env（已被 .gitignore 排除，不会入仓），填入真实值作为备忘；
#   2) 在部署环境注入（本机 Windows 可用 setx，Linux 用 export / systemd EnvironmentFile / K8s Secret）；
#   3) **切勿**把真实值写回 application.yml——AGENTS.md §7.1 安全红线。
#
# 命名约定：统一 DKD_ 前缀，避免与同机其他项目环境变量冲突。
# 注意：setx 只对**新启动**的进程生效，设置后需重启 IDE / 终端。
######################################################################

# ---- MySQL（dkd 库，dkd-parent 与 dkd-app 共用）----
DKD_DB_PASSWORD=

# ---- Redis ----
DKD_REDIS_PASSWORD=

# ---- Druid 监控台登录密码（login-username: ruoyi，访问 /druid）----
DKD_DRUID_PASSWORD=

# ---- JWT 令牌密钥（dkd-parent 管理后台）----
# 建议 32 位以上随机串；原值为 RuoYi 模板自带的弱密钥，已废弃并需轮换
DKD_JWT_SECRET=

# ---- JWT 令牌密钥（dkd-app 运维移动端，独立于上面的管理后台）----
# 为什么单独一个：两套服务鉴权体系互不共用（AGENTS §7.5 的思路）。
# 必须 >=32 字节；缺失时 dkd-app 启动即失败（fail-closed），不要给默认值。
# 2026-10-21 前这里是源码里的硬编码常量 "dkd"，任何人拿到仓库即可伪造令牌（审计 F2）。
DKD_APP_JWT_SECRET=
# 令牌有效期（分钟），默认 720（12 小时）
DKD_APP_JWT_EXPIRE_MINUTES=720

# ---- 短信验证码 ----
# true = 不真实下发（仍随机生成、不落日志），仅本地/联调可用；生产必须 false
DKD_SMS_MOCK=false

# ---- Swagger 接口文档 ----
# 默认关闭；本地/联调需要看文档时设为 true（生产保持关闭，见审计 2026-10-21 F9）
DKD_SWAGGER_ENABLED=false

# ---- 阿里云 OSS（x-file-storage 文件上传平台）----
DKD_OSS_ACCESS_KEY=
DKD_OSS_SECRET_KEY=

# ---- LLM（DeepSeek，dkd-common 的 IAiService 兜底链路使用）----
DKD_DEEPSEEK_API_KEY=

# ====================================================================
# dkd-agent（Python 智能体服务）自身变量
# 说明：服务只监听内网/回环，对外经 Java 网关；详见 dkd-agent/README.md
# ====================================================================

# 运行环境：dev / test / prod
DKD_AGENT_ENV=dev

# MySQL 账号（任务 0-4）：业务表只读白名单 + agent_* 自有表可写，无 DELETE/DDL
# 建权脚本：docs/ddl/create_agent_db_user.sql
DKD_AGENT_DB_USER=dkd_agent
DKD_AGENT_DB_PASSWORD=

# 服务间密钥：与 Java 侧 AgentProperties.secret 必须一致（回调/运维接口鉴权）
# 未配置时回调类接口一律返回 503，绝不默认放行
DKD_AGENT_SERVICE_SECRET=

# 会话 checkpoint 后端：sqlite（默认，单实例）| postgres（多实例/跨机共享会话）
# 切换是显式动作：改这一个值即可，回滚也只需改回 sqlite（不做双向数据同步）
DKD_AGENT_CHECKPOINT_BACKEND=sqlite

# 会话 checkpoint（SQLite）：该文件需纳入定期备份；切到 postgres 后此文件仍保留（回滚用）
DKD_AGENT_SQLITE_PATH=var/checkpoints.db

# PG 连接串（**仅 checkpoint 使用；不是业务数据通道**）
# 仅当 DKD_AGENT_CHECKPOINT_BACKEND=postgres 时必填；缺失时服务拒绝启动
# 授权脚本：docs/ddl/create_agent_pg_role.sql（只授 checkpoint 表，明确不授任何业务库）
# 口令只写入本机 .env，模板与代码中一律占位符（AGENTS §7.1）
DKD_AGENT_PG_DSN=

# PG 连接池上限（仅 postgres 后端）。单实例默认 4 够用；多实例部署时按「副本数 × 上限」评估总量。
# 为什么需要池而不是单连接：langgraph 的 from_conn_string 内部是**单个**连接，
# 连接一断 saver 就永久失效（只有重启进程才能恢复）——见 FIX-23。
DKD_AGENT_PG_POOL_MAX=4

# 建池时等待首个连接的超时（秒）：PG 不可达时应尽早失败，而不是把启动挂在这里
DKD_AGENT_PG_POOL_OPEN_TIMEOUT=10

# 是否用真实 LLM（0=echo 链路，1=真实调用；为 1 但无密钥时启动即失败）
DKD_AGENT_USE_LLM=0

# 审计/留痕开关（0=只跑链路不写库，便于本地调试）
DKD_AGENT_AUDIT_ENABLED=1

# token 限额（0=不限制）；超限返回 429，用于防成本失控
DKD_AGENT_TOKEN_LIMIT_PER_USER=200000
DKD_AGENT_TOKEN_LIMIT_GLOBAL=2000000

# ====================================================================
# 只读工具层护栏（Phase 1 / 任务 1-1、1-2）
# 本机只有一个主库（无只读从库），分析类查询必须能限时/限批/限行
# ====================================================================

# 单条只读查询超时（秒），超时即熔断（抛 QueryTimeoutError，不拖垮与业务共用的主库）
DKD_AGENT_READ_QUERY_TIMEOUT_S=5

# 按设备分批的批大小（IN 列表不能无限长：解析/计划开销随元素数增长）
DKD_AGENT_READ_BATCH_SIZE=50

# 单次查询行数上限（兜底，禁止无 LIMIT 的全表扫描）
DKD_AGENT_READ_ROW_LIMIT=2000

# 销量口径：tb_order.status 取值（2=出货成功，依据 ReportServiceImpl.java:28）
DKD_AGENT_SALES_ORDER_STATUS=2

# ====================================================================
# 工单回调（Phase 1 / 任务 1-3）——写操作的唯一通道
# ====================================================================

# 建单回调超时（秒）。给 10s 的理由：建单是**非幂等**动作，超时后结果未知，
# 传输层不重试（冒重试风险重复建单比显式失败更糟），由计划状态机决定是否重试
DKD_AGENT_CALLBACK_TIMEOUT_S=10

# ====================================================================
# 补货基线引擎参数（Phase 1 / 任务 1-4）
# 全是**业务参数**（随运营策略变），排期 3-6/5-2 要按复盘结果迭代，故不进代码常量
# ====================================================================

# 逐日销量的分位数（0.75 = 75% 的日子不会超过这个量）
DKD_AGENT_RESTOCK_QUANTILE=0.75

# 补货周期天数（两次补货之间的间隔；目标库存 = 日均需求 × 该值 × 服务水平）
DKD_AGENT_RESTOCK_COVERAGE_DAYS=2

# 服务水平系数（>1 即留安全余量）
DKD_AGENT_RESTOCK_SERVICE_FACTOR=1.2

# 目标库存下限 = 最小预警值 × 该倍数（与现有规则版 generateRestockSuggestion 对齐）
DKD_AGENT_RESTOCK_MIN_STOCK_MULTIPLE=2

# 无可信样本时的兜底补货比例（与规则版一致：按容量 85% 补满）
DKD_AGENT_RESTOCK_FILL_RATIO=0.85

# 多窗口权重（近窗更敏感、长窗更稳）；格式 天数:权重，逗号分隔
DKD_AGENT_RESTOCK_WINDOW_WEIGHTS=7:0.5,14:0.3,30:0.2

# ====================================================================
# 补货 LLM 校准（Phase 1 / 任务 1-5）
# LLM 输出是**不可信输入**（AGENTS §7.6）：只允许它给系数，且系数必被夹取
# ====================================================================

# 开关：关掉即退化为“纯统计基线”（DeepSeek 不可用/成本收紧时的降级手段）
DKD_AGENT_RESTOCK_CALIBRATION_ENABLED=1

# 系数夹取区间（LLM 说 ×10 也只会取到上限；说 ×0 也不会把必需的补货抹掉）
DKD_AGENT_RESTOCK_CALIBRATION_MIN_FACTOR=0.7
DKD_AGENT_RESTOCK_CALIBRATION_MAX_FACTOR=1.5

# 单次请求最多送多少条货道（控制 prompt 体积与 token 成本）
DKD_AGENT_RESTOCK_CALIBRATION_BATCH_SIZE=20
